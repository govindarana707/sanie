APP_ENV=production
APP_DEBUG=0
BASE_URL=https://example.com/backend/api
FRONTEND_URL=https://example.com/frontend
# Development only: raw password-reset links are written here when APP_ENV=development.
PASSWORD_RESET_DEV_LOG=backend/storage/password-reset-deliveries.log
# Production password-reset delivery. Username/password must be configured
# together when the SMTP relay requires authentication.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SanIE
MAIL_TIMEOUT_SECONDS=10
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://example.com

DB_HOST=127.0.0.1
DB_DATABASE=sanie_db
DB_USERNAME=sanie
DB_PASSWORD=replace-me

# CLI-only reset requires both this flag and --confirm.
ALLOW_FINANCIAL_RESET=0
ALLOW_DIAGNOSTICS=0
